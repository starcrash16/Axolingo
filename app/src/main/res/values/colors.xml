<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Archivo colors.xml: define la paleta de colores usada en la aplicación.
        Añade o modifica estos valores para ajustar el tema visual de la app.
    -->

    <!-- Paleta primary/secondary (material default) -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>

    <!-- Colores básicos -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Colores de la UI/tema personalizados -->
    <!-- `yellow`: color brillante usado en botones o acentos -->
    <color name="yellow">#FFC801</color>
    <!-- `turquoise`: color secundario para acentos suaves -->
    <color name="turquoise">#38D5B8</color>
    <!-- `red`: color de error/alertas -->
    <color name="red">#FFD32F2F</color>
    <!-- `blue`: color principal para botones/elementos activos -->
    <color name="blue">#0960FB</color>
    <!-- `dark_blue`: color de fondo oscuro o para texto claro sobre fondo oscuro -->
    <color name="dark_blue">#001741</color>
    <!-- `dark_yellow`: color oscuro tipo naranja/amarillo para contrastes -->
    <color name="dark_yellow">#FF751F</color>
</resources>