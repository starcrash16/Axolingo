<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado seleccionado (cuando el usuario lo toca y antes de soltar) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFB300" />
            <corners android:radius="8dp" />
            <padding android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp"/>
        </shape>
    </item>
    <!-- Estado deshabilitado (cuando se ha emparejado correctamente) -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#B3E5FC" />

            <corners android:radius="8dp" />
            <padding android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp"/>
        </shape>
    </item>
    <!-- Estado por defecto (enabled=true) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00BCD4" />

            <corners android:radius="8dp" />
            <padding android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp"/>
        </shape>
    </item>
</selector>