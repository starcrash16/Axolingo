<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grad_salmon_to_white"
    tools:context=".leccion_mate.actividad_canasta.ActividadCanasta">

    <!-- ================= CAPA DE JUEGO ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_game_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Expresión Matemática -->
        <TextView
            android:id="@+id/tv_expression"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Construye tu expresión matemática"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#37474F"
            android:gravity="center"
            android:padding="16dp"
            android:background="#80FFFFFF"
            android:layout_margin="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Contenedor de Vidas -->
        <LinearLayout
            android:id="@+id/lives_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_expression"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/heart1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/corazon"
                android:layout_marginEnd="4dp"
                android:contentDescription="Vida 1" />

            <ImageView
                android:id="@+id/heart2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/corazon"
                android:layout_marginEnd="4dp"
                android:contentDescription="Vida 2" />

            <ImageView
                android:id="@+id/heart3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/corazon"
                android:contentDescription="Vida 3" />
        </LinearLayout>

        <!-- Puntuación -->
        <TextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puntuación: 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#37474F"
            android:padding="12dp"
            android:background="#80FFFFFF"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_expression"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Vista del Juego -->
        <com.proyecto_final.axolingo.leccion_mate.actividad_canasta.CanastaGameView
            android:id="@+id/game_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/lives_container"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
            
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= CAPA DE INICIO (POP UP PERSONALIZADO) ================= -->
    <FrameLayout
        android:id="@+id/layout_start_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <androidx.cardview.widget.CardView
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡RETO MATEMÁTICO!"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#3873b1"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Atrapa los números y signos para formar una operación.\n2. Atrapa el HUEVO BUENO para puntos extra.\n3. ¡Evita los huevos malos!\n4. Al final, resuelve la operación."
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="24dp"/>

                <com.proyecto_final.axolingo.art.botons.BotonMenuPrincipalAzul
                    android:id="@+id/btn_start_game"
                    android:layout_width="200dp"
                    android:layout_height="60dp"
                    android:text="INICIAR JUEGO" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- ================= CAPA DE VALIDACIÓN (RESOLVER ECUACIÓN) ================= -->
    <LinearLayout
        android:id="@+id/layout_validation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/grad_salmon_to_white"
        android:visibility="gone"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Expresión Completa!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#37474F"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tv_final_expression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 + 2 - 1 + 5 - 3 = ?"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#3873b1"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/et_result_input"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:hint="Resultado"
            android:inputType="numberSigned"
            android:textSize="24sp"
            android:gravity="center"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:layout_marginBottom="24dp"/>

        <com.proyecto_final.axolingo.art.botons.BotonMenuPrincipalAzul
            android:id="@+id/btn_validate_result"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="VERIFICAR" />

    </LinearLayout>

    <!-- ================= CAPA DE RESULTADO FINAL ================= -->
    <LinearLayout
        android:id="@+id/layout_final_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/grad_salmon_to_white"
        android:visibility="gone"
        android:padding="24dp">

        <ImageView
            android:id="@+id/img_result_icon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/huevo_bien" 
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tv_congrats_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡FELICIDADES!"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_final_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puntuación Final: 100"
            android:textSize="24sp"
            android:textColor="#37474F"
            android:gravity="center"
            android:layout_marginBottom="40dp"/>

        <com.proyecto_final.axolingo.art.botons.BotonMenuPrincipalAzul
            android:id="@+id/btn_return_menu"
            android:layout_width="250dp"
            android:layout_height="70dp"
            android:text="REGRESAR AL MENÚ" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>