<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_leccion_ingles"
    tools:context=".leccion_ingles.MenuLeccionInglesActivity">

    <!-- Imagen del Ajolote con la pizarra -->
    <ImageView
        android:id="@+id/imageAxoPizarra"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/axo_rojo_ingles"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttonContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="Axolote enseñando inglés" />

    <!-- Contenedor vertical para los botones -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingEnd="16dp"
        app:layout_constraintStart_toEndOf="@+id/imageAxoPizarra"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Botón 1 (Amarillo) -->
        <com.proyecto_final.axolingo.art.botons.BotonLeccion
            android:id="@+id/btnSpellingBee"
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:text="PALABRAS!!\nSPELLING BEE"
            app:mainButtonColor="#ffde59"
            app:shadowButtonColor="#fc5a41"
            android:textColor="#fc5a41"/>

        <!-- Botón 2 (Azul) -->
        <com.proyecto_final.axolingo.art.botons.BotonLeccion
            android:id="@+id/btnReading"
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:text="READING\nCOMPREHENSION"
            app:mainButtonColor="#0cc0df"
            app:shadowButtonColor="#0960fb"
            android:textColor="@android:color/white"/>

        <!-- Botón 3 (Rosa) -->
        <com.proyecto_final.axolingo.art.botons.BotonLeccion
            android:id="@+id/btnVocabulary"
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:text="VOCABULARY"
            app:mainButtonColor="#E91E63"
            app:shadowButtonColor="#C2185B"
            android:textColor="@android:color/white"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

