<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo Gradiente Personalizado -->
    <com.proyecto_final.axolingo.art.CLienzoGradientePrincipal
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Título Inspiración -->
            <TextView
                android:id="@+id/tvInspiracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inspiración"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Texto Axolingo -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Axolingo\n\nnace como un proyecto de la materia de 7mo semestre de programación móviles con el objetivo de aplicar el conocimiento aprendido a lo largo del semestre, buscando realizar una aplicación educativa para cualquier niño de manera didáctica y entretenida."
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@+id/tvInspiracion"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Container René (Orange Border) -->
            <FrameLayout
                android:id="@+id/containerRene"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/white_circle_background"
                android:backgroundTint="#FF9800"
                android:padding="5dp"
                app:layout_constraintTop_toBottomOf="@+id/tvDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/containerLuis"
                app:layout_constraintHorizontal_chainStyle="spread">
                
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="65dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/yo"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Container Luis (Blue Border) -->
            <FrameLayout
                android:id="@+id/containerLuis"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/white_circle_background"
                android:backgroundTint="#2196F3"
                android:padding="5dp"
                app:layout_constraintTop_toBottomOf="@+id/tvDescription"
                app:layout_constraintStart_toEndOf="@+id/containerRene"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="65dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/alberto"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Nombres -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="René Rosendo\nDe Anda Medina"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/containerRene"
                app:layout_constraintStart_toStartOf="@+id/containerRene"
                app:layout_constraintEnd_toEndOf="@+id/containerRene"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Luis Alberto\nHernández Velasco"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/containerLuis"
                app:layout_constraintStart_toStartOf="@+id/containerLuis"
                app:layout_constraintEnd_toEndOf="@+id/containerLuis"/>


            <!-- Botón Regresar -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regresar"
                android:backgroundTint="@color/white"
                android:textColor="#0960fb"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@+id/containerRene"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="1.0"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
