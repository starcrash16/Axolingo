<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/gradient_leccion_mate"
    tools:context=".leccion_mate.MenuLeccionMateActivity">

    <!-- Imagen del Ajolote con la pizarra -->
    <ImageView
        android:id="@+id/imageAxoPizarra"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/axo_rojo_mate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttonContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="Axolote enseñando matemáticas" />

    <!-- Contenedor vertical para los botones -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingEnd="16dp"
        app:layout_constraintStart_toEndOf="@+id/imageAxoPizarra"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintBottom_toTopOf="@+id/bottomNavContainer">

        <com.proyecto_final.axolingo.art.botons.BotonLeccion
            android:id="@+id/btnPizarra"
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:textSize="20dp"
            android:text="PIZARRA\nMÁGICA"
            app:mainButtonColor="#0cc0df"
            app:shadowButtonColor="#0960fb"
            android:textColor="@android:color/white"/>

        <com.proyecto_final.axolingo.art.botons.BotonLeccion
            android:id="@+id/btnCanasta"
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:layout_marginTop="36dp"
            android:textSize="25dp"
            android:text="CANASTA"
            app:mainButtonColor="#FF9800"
            app:shadowButtonColor="#F57C00"
            android:textColor="@android:color/white"/>

    </LinearLayout>

    <!-- FOOTER NAVBAR -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@drawable/footer"
        android:elevation="8dp"
        android:paddingTop="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <!-- Botón Home -->
        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/icono_home"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="@android:color/darker_gray"
            android:contentDescription="Home"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <!-- Botón Settings -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/icono_settings"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="@android:color/darker_gray"
            android:contentDescription="Settings"/>
    </LinearLayout>

    <!-- TextView para el punchline (oculto inicialmente) -->
    <TextView
        android:id="@+id/tv_punchline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="1sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btn_chiste"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:src="@drawable/axo_rosa_boton"
        app:tint="@null"
        android:contentDescription="Acción principal"
        android:elevation="12dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
