<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFCDD2"

    tools:context=".leccion_ingles.VocabularyActivity">

    <!-- Custom View para dibujar las líneas de conexión -->
    <com.proyecto_final.axolingo.leccion_ingles.leccion_ingles.LineDrawingView
        android:id="@+id/line_drawing_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Match the Word to its Definition"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#37474F"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenedor Izquierdo (Palabras) -->
    <LinearLayout
        android:id="@+id/left_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintBottom_toTopOf="@id/tv_completion_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.45">

        <!-- Los botones serán inflados dinámicamente en Kotlin -->

        <!-- Placeholder para la estructura de un botón de Palabra -->
        <Button
            android:id="@+id/word_1"
            style="@style/MatchingButton.Word"
            android:text="Word 1"
            tools:ignore="HardcodedText" />
        <Button
            android:id="@+id/word_2"
            style="@style/MatchingButton.Word"
            android:text="Word 2"
            tools:ignore="HardcodedText" />
        <Button
            android:id="@+id/word_3"
            style="@style/MatchingButton.Word"
            android:text="Word 3"
            tools:ignore="HardcodedText" />
        <Button
            android:id="@+id/word_4"
            style="@style/MatchingButton.Word"
            android:text="Word 4"
            tools:ignore="HardcodedText" />
        <Button
            android:id="@+id/word_5"
            style="@style/MatchingButton.Word"
            android:text="Word 5"
            tools:ignore="HardcodedText" />
        <Button
            android:id="@+id/word_6"
            style="@style/MatchingButton.Word"
            android:text="Word 6"
            tools:ignore="HardcodedText" />

    </LinearLayout>

    <!-- Contenedor Derecho (Definiciones) -->
    <LinearLayout
        android:id="@+id/right_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintBottom_toTopOf="@id/tv_completion_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.45">

        <!-- Placeholder para la estructura de un botón de Definición -->
        <Button
            android:id="@+id/def_1"
            style="@style/MatchingButton.Definition"
            android:text="Definition 1"
            tools:ignore="HardcodedText" />
        <Button
            android:id="@+id/def_2"
            style="@style/MatchingButton.Definition"
            android:text="Definition 2"
            tools:ignore="HardcodedText" />
        <Button
            android:id="@+id/def_3"
            style="@style/MatchingButton.Definition"
            android:text="Definition 3"
            tools:ignore="HardcodedText" />
        <Button
            android:id="@+id/def_4"
            style="@style/MatchingButton.Definition"
            android:text="Definition 4"
            tools:ignore="HardcodedText" />
        <Button
            android:id="@+id/def_5"
            style="@style/MatchingButton.Definition"
            android:text="Definition 5"
            tools:ignore="HardcodedText" />
        <Button
            android:id="@+id/def_6"
            style="@style/MatchingButton.Definition"
            android:text="Definition 6"
            tools:ignore="HardcodedText" />

    </LinearLayout>

    <!-- Mensaje de Completado -->
    <TextView
        android:id="@+id/tv_completion_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="All matched! Vocabulary complete."
        android:textSize="20sp"
        android:textColor="#004D40"
        android:gravity="center"
        android:visibility="gone"
        android:padding="8dp"
        android:background="#80CBC4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
