<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grad_salmon_to_white"

    tools:context=".leccion_ingles.VocabularyActivity">

    <!-- Custom View para dibujar las líneas de conexión -->
    <com.proyecto_final.axolingo.leccion_ingles.leccion_ingles.LineDrawingView
        android:id="@+id/line_drawing_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Match the Word to its Definition"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#37474F"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenedor Izquierdo (Palabras) -->
    <LinearLayout
        android:id="@+id/left_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintBottom_toTopOf="@id/btnReset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.42">

        <!-- Las cajas de palabras serán infladas dinámicamente en Kotlin -->

    </LinearLayout>

    <!-- Contenedor Derecho (Definiciones) -->
    <LinearLayout
        android:id="@+id/right_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintBottom_toTopOf="@id/btnReset"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.42">

        <!-- Las cajas de definiciones serán infladas dinámicamente en Kotlin -->

    </LinearLayout>

    <!-- Botón Reiniciar -->
    <com.proyecto_final.axolingo.art.botons.BotonMenuPrincipal
        android:id="@+id/btnReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reiniciar"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botón Validar -->
    <com.proyecto_final.axolingo.art.botons.BotonMenuPrincipalAzul
        android:id="@+id/btnValidate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Validar"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mensaje de Completado (opcional, oculto) -->
    <TextView
        android:id="@+id/tv_completion_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="All matched! Vocabulary complete."
        android:textSize="20sp"
        android:textColor="#004D40"
        android:gravity="center"
        android:visibility="gone"
        android:padding="8dp"
        android:background="#80CBC4"
        app:layout_constraintBottom_toTopOf="@id/btnReset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Congratulatory Message -->
    <LinearLayout
        android:id="@+id/congratulations_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="16dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_congratulations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Felicidades!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tuviste X aciertos."
            android:textSize="18sp"
            android:textColor="#37474F"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <com.proyecto_final.axolingo.art.botons.BotonMenuPrincipal
            android:id="@+id/btn_main_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menú Principal"
            android:layout_marginBottom="16dp" />

        <com.proyecto_final.axolingo.art.botons.BotonMenuPrincipalAzul
            android:id="@+id/btn_restart_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reiniciar Juego"
            android:layout_marginBottom="16dp" />

        <com.proyecto_final.axolingo.art.botons.BotonMenuPrincipal
            android:id="@+id/btn_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retroalimentación" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
